<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PipeMasterMEP.JanelaConfigInclinacao" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações de Inclinações" Height="480" Width="450" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI" xmlns:pipemastermep="clr-namespace:PipeMasterMEP;assembly=PipeMasterM">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="BtnPremium" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" CornerRadius="6" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnGhost" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" CornerRadius="6" Background="{TemplateBinding Control.Background}" BorderBrush="#C8C8C8" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#FFF0E3" />
                  <Setter Property="Foreground" Value="#333333" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#C8C8C8" />
        <Setter Property="DataGrid.RowBackground" Value="#FFFFFFFF" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#F2F2F2" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#C8C8C8" />
        <Setter Property="DataGrid.VerticalGridLinesBrush" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="DataGrid.RowHeight" Value="32" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#E6E6E6" />
        <Setter Property="Foreground" Value="#5A5A5A" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#C8C8C8" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Border Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="#FFF0E3" />
            <Setter Property="Foreground" Value="#333333" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#E6E6E6" CornerRadius="10" BorderBrush="#C8C8C8" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="45" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="#F2F2F2" CornerRadius="9,9,0,0" MouseLeftButtonDown="MoverJanela_MouseLeftButtonDown">
        <Grid>
          <TextBlock Text="Configurações de Inclinações" Foreground="#333333" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" />
          <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="#00FFFFFF" BorderThickness="0" Foreground="#6B6B6B" Content="✕" FontSize="14" Cursor="Hand" Click="BtnFechar_Click">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="bdr" Background="#00FFFFFF" CornerRadius="15">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="bdr" Property="Border.Background" Value="#E81123" />
                    <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </Grid>
      </Border>
      <Grid Row="1" Margin="25">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
          <TextBlock Text="SISTEMA" Foreground="#6B6B6B" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" />
          <ComboBox Name="cmbSistemas" Height="32" Width="250" HorizontalAlignment="Left" FontSize="13" SelectionChanged="CmbSistemas_SelectionChanged" />
        </StackPanel>
        <DataGrid Name="dgRegras" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Diâmetro (mm)" Width="*" Binding="{Binding Diametro}" />
            <DataGridTextColumn Header="Inclinação (%)" Width="*" Binding="{Binding InclinacaoPorcentagem, StringFormat=F1}" />
          </DataGrid.Columns>
        </DataGrid>
        <CheckBox Name="chkNivelar" Grid.Row="2" Margin="0,20,0,0" VerticalAlignment="Center" Foreground="#333333" FontSize="13">
          <TextBlock Text="Nivelar tampa das caixas sifonadas ao inclinar" Margin="5,0,0,0" />
        </CheckBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
          <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Width="100" Height="36" Margin="0,0,10,0" Click="BtnFechar_Click" />
          <Button Content="Salvar Regras" Style="{StaticResource BtnPremium}" Width="130" Height="36" Click="BtnOk_Click">
            <Control.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF9800" Offset="0.0" />
                <GradientStop Color="#F57C00" Offset="1.0" />
              </LinearGradientBrush>
            </Control.Background>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
