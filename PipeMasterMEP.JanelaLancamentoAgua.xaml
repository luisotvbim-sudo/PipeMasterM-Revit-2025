<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PipeMasterMEP.JanelaLancamentoAgua" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PipeMasterMEP" Language="pt-BR" Title="PipeMaster - Lançamento de Água" SizeToContent="Height" MaxHeight="720" Width="820" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolVis" />
      <Style x:Key="BotaoEngrenagem" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="⚙" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#888888" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="#4EB4FF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Rotulo" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#AAAAAA" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
      </Style>
      <Style x:Key="TituloCard" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <Style x:Key="CampoNumero" TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#3D3D3D" />
        <Setter Property="TextBox.TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="CheckClaro" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="RadioClaro" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
        <RowDefinition Height="60" />
      </Grid.RowDefinitions>
      <Border Background="#252526" CornerRadius="10,10,0,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <TextBlock Text="PIPEMASTER ÁGUA" Foreground="#4EB4FF" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" />
            <TextBlock Text="|" Foreground="#555555" FontFamily="Segoe UI" FontSize="14" Margin="0,0,10,0" />
            <TextBlock Foreground="#CCCCCC" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Text="{Binding NomeAmbiente}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Name="TxtEtapa" Text="ETAPA 1/2 — SISTEMA E APARELHOS" Foreground="#777777" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Name="BtnFechar" Content="✕" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,10,0" Background="#00FFFFFF" Foreground="#888888" BorderThickness="0" FontSize="14" Click="BtnFechar_Click">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFFFF" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Name="Pagina1" Row="1" Margin="20,15,20,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15">
          <StackPanel>
            <TextBlock Text="1. SISTEMA" Style="{StaticResource TituloCard}" />
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="Sistema" Content="Água Fria" Style="{StaticResource RadioClaro}" IsEnabled="False" IsChecked="{Binding IsAguaFria}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="15">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="2. QUAIS APARELHOS PARTICIPAM DO LANÇAMENTO?" Style="{StaticResource TituloCard}" />
              <StackPanel Margin="0,0,0,10">
                <CheckBox Content="Usar aparelhos sanitários do vínculo de arquitetura" Style="{StaticResource CheckClaro}" IsChecked="{Binding UsarVinculo}" />
                <StackPanel Orientation="Horizontal" Margin="25,5,0,0" Visibility="{Binding VisibilidadeOpcaoImportar}">
                  <CheckBox Content="Importar aparelhos para o projeto (mapeamento)" Style="{StaticResource CheckClaro}" VerticalAlignment="Center" IsChecked="{Binding ImportarDoVinculo}" />
                  <Button Name="BtnMapeamento" Content="Mapear Famílias..." Margin="15,0,0,0" Padding="8,2" Background="#333333" Foreground="#CCCCCC" BorderBrush="#555" Click="BtnMapeamento_Click" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Grid Row="1" Margin="9,0,8,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <Button Name="BtnSelecionarAparelhos" Grid.Column="1" HorizontalAlignment="Left" Content="⧉  Selecionar por Janela" Padding="10,3" Margin="0,0,0,4" Background="#333333" Foreground="#CCCCCC" BorderBrush="#555" ToolTip="Fecha esta janela, você arrasta uma janela de seleção sobre os aparelhos no Revit, e ela reabre marcando só os que estiverem dentro." Click="BtnSelecionarAparelhos_Click" />
              <TextBlock Grid.Column="2" Text="Tipo do Ponto" Style="{StaticResource Rotulo}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Bottom" />
            </Grid>
            <ListBox Name="ListaPecas" Grid.Row="2" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Pecas}" SelectionChanged="ListaPecas_SelectionChanged">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                  <Setter Property="Margin" Value="0,0,0,6" />
                  <Setter Property="Background" Value="#1E1E1E" />
                  <Setter Property="BorderBrush" Value="#1E1E1E" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#5A5A5A" />
                          </Trigger>
                          <Trigger Property="ListBoxItem.IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="#9455D3" />
                            <Setter Property="Background" Value="#2A2135" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Selecionada}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                      <TextBlock Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding NomeExibicao}" />
                      <TextBlock Foreground="#777777" FontFamily="Segoe UI" FontSize="10" TextTrimming="CharacterEllipsis" Text="{Binding NomeOriginal}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" ItemsSource="{x:Static local:LancamentoAguaViewModel.TiposPonto}" Height="24" VerticalContentAlignment="Center" SelectedItem="{Binding TipoSelecionado}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <Grid Name="Pagina2" Row="1" Margin="20,15,20,10" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="15" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15">
              <StackPanel>
                <TextBlock Text="3. SISTEMA E MATERIAL" Style="{StaticResource TituloCard}" />
                <TextBlock Text="Sistema de Tubulação:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <ComboBox Height="24" Margin="0,0,0,10" VerticalContentAlignment="Center" ItemsSource="{Binding SistemasDisponiveis}" SelectedItem="{Binding SistemaSelecionado}" />
                <TextBlock Text="Tipo de Tubo:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <ComboBox Height="24" Margin="0,0,0,10" VerticalContentAlignment="Center" ItemsSource="{Binding TiposTuboDisponiveis}" SelectedItem="{Binding TipoTuboSelecionado}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Ø Ramal (mm):" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding DiametroRamal, StringFormat=N0}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Ø Descidas (mm):" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding DiametroDescida, StringFormat=N0}" />
                </StackPanel>
                <CheckBox Content="Inverter sentido da bucha" Style="{StaticResource CheckClaro}" Margin="0,8,0,0" ToolTip="Em alguns templates o joelho de 90° com bucha de latão fica com a bucha voltada para o lado errado. Marque para inverter o sentido nas conexões dos pontos." IsChecked="{Binding InverterSentidoBucha}" />
              </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15">
              <StackPanel>
                <TextBlock Text="4. ALTURAS (m)" Style="{StaticResource TituloCard}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Início da Prumada:" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding AlturaPrumada, StringFormat=N2}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Registro:" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding AlturaRegistro, StringFormat=N2}" />
                </StackPanel>
                <CheckBox Content="Inserir registro na prumada" Style="{StaticResource CheckClaro}" Margin="0,0,0,8" IsChecked="{Binding InserirRegistro}" />
                <TextBlock Text="Família do Registro:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <ComboBox Height="24" Margin="0,0,0,10" VerticalContentAlignment="Center" ItemsSource="{Binding FamiliasRegistroDisponiveis}" SelectedItem="{Binding FamiliaRegistroSelecionada}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Ramal na parede:" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding AlturaRamal, StringFormat=N2}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Recuo na parede (cm):" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding RecuoParede, StringFormat=N0}" />
                </StackPanel>
                <CheckBox Content="Desviar caminhamento pelo piso" Style="{StaticResource CheckClaro}" Margin="0,0,0,8" ToolTip="Para o aparelho mais distante pelo caminhamento das paredes (ex.: do outro lado do ambiente), desce ao piso, atravessa reto por baixo e sobe do outro lado, em vez de seguir embutido pela parede até lá." IsChecked="{Binding DesviarPeloPiso}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding DesviarPeloPiso, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="Altura do desvio no piso (m):" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding AlturaPiso, StringFormat=N2}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15" Visibility="{Binding TemChuveiroSelecionado, Converter={StaticResource BoolVis}}">
              <StackPanel>
                <TextBlock Text="5. REGISTRO DE PRESSÃO (CHUVEIRO)" Style="{StaticResource TituloCard}" />
                <CheckBox Content="Inserir Registro de Pressão" Style="{StaticResource CheckClaro}" Margin="0,0,0,8" IsChecked="{Binding InserirRegistroPressao}" />
                <TextBlock Text="Família do Registro de Pressão:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <ComboBox Height="24" Margin="0,0,0,10" VerticalContentAlignment="Center" ItemsSource="{Binding FamiliasRegistroDisponiveis}" SelectedItem="{Binding FamiliaRegistroPressaoSelecionada}" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Altura do Registro (m):" Style="{StaticResource Rotulo}" Width="130" />
                  <TextBox Style="{StaticResource CampoNumero}" Text="{Binding AlturaRegistroPressao, StringFormat=N2}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="2" Background="#252526" CornerRadius="6" Padding="15">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <TextBlock Text="RESUMO DO LANÇAMENTO" Style="{StaticResource TituloCard}" />
              <Button Name="BtnConfigGeral" Style="{StaticResource BotaoEngrenagem}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" ToolTip="Configurações: alturas e offsets dos pontos, e padrões salvos (presets) por cliente." Click="BtnConfigGeral_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Resumo}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                      <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis">
                        <Run FontWeight="SemiBold" Foreground="#FFFFFFFF" Text="{Binding NomeExibicao, Mode=OneWay}" /> <Run Text=" — altura " /> <Run Text="{Binding AlturaPonto, Mode=OneWay, StringFormat=N2}" /> <Run Text=" m · offset " /> <Run Text="{Binding OffsetCm, Mode=OneWay, StringFormat=N0}" /> <Run Text=" cm" /></TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#252526" CornerRadius="0,0,10,10" BorderBrush="#3D3D3D" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock Name="TxtRodape" Text="Clique numa linha para destacar o aparelho na planta." Style="{StaticResource Rotulo}" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
            <Button Name="BtnCancelar" Content="CANCELAR" Width="90" Height="30" Margin="0,0,10,0" Background="#333333" Foreground="#FFFFFFFF" BorderThickness="0" Click="BtnCancelar_Click" />
            <Button Name="BtnVoltar" Content="◀  VOLTAR" Width="90" Height="30" Margin="0,0,10,0" Background="#333333" Foreground="#FFFFFFFF" BorderThickness="0" Visibility="Collapsed" Click="BtnVoltar_Click" />
            <Button Name="BtnAvancar" Content="AVANÇAR  ▶" Width="150" Height="30" Background="#4EB4FF" Foreground="#FF000000" FontWeight="SemiBold" BorderThickness="0" Click="BtnAvancar_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>