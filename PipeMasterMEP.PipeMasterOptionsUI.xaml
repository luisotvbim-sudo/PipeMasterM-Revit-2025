<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PipeMasterMEP.PipeMasterOptionsUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="32" Background="#00FFFFFF" VerticalAlignment="Center" xmlns:pipemastermep="clr-namespace:PipeMasterMEP;assembly=PipeMasterM">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
    <RadioButton Name="RbPadrao" Content="Padrão" VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="Segoe UI" FontSize="12" IsChecked="{Binding IsPadrao}" />
    <RadioButton Name="RbPersonalizado" Content="Personalizado" VerticalAlignment="Center" Margin="0,0,15,0" FontFamily="Segoe UI" FontSize="12" IsChecked="{Binding IsPersonalizado}" />
    <Rectangle Width="1" Height="20" Fill="#D0D0D0" Margin="0,0,15,0" VerticalAlignment="Center" />
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
      <TextBlock Text="Comp. (m):" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="12" />
      <TextBox Width="45" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" FontFamily="Segoe UI" FontSize="12" TextAlignment="Center" Text="{Binding Comprimento, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsPersonalizado}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <TextBlock Text="Tipo:" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="12" />
      <ComboBox DisplayMemberPath="Name" Width="140" Height="22" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,15,0" ItemsSource="{Binding TiposDeTubo}" SelectedItem="{Binding TipoSelecionado}" />
      <TextBlock Text="Sistema:" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="12" />
      <ComboBox DisplayMemberPath="Name" Width="130" Height="22" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,15,0" ItemsSource="{Binding Sistemas}" SelectedItem="{Binding SistemaSelecionado}" />
      <TextBlock Text="Diâmetro:" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="12" />
      <ComboBox Width="60" Height="22" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" ItemsSource="{Binding Diametros}" SelectedItem="{Binding DiametroSelecionado}" />
    </StackPanel>
  </StackPanel>
</UserControl>