<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PipeMasterMEP.UIRamalOptionsBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="28" Background="#E6E6E6" Foreground="#333333" VerticalAlignment="Center" xmlns:pipemastermep="clr-namespace:PipeMasterMEP;assembly=PipeMasterM">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0" TextElement.FontFamily="Segoe UI" TextElement.FontSize="11">
    <TextBlock Text="Transição do Ramal:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{Binding TextColor}" />
    <RadioButton Content="Padrão (Joelho 90º)" VerticalAlignment="Center" Margin="0,0,15,0" IsChecked="{Binding IsPadrao, Mode=TwoWay}" Foreground="{Binding TextColor}" />
    <RadioButton Content="Suave (Duplo Joelho 45º)" VerticalAlignment="Center" IsChecked="{Binding IsSuave, Mode=TwoWay}" Foreground="{Binding TextColor}" />
  </StackPanel>
</UserControl>
